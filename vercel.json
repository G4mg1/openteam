{
  "version": 2,
  "name": "mirox-ai",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/v1/chat/completions", "destination": "/api/index" },
    { "source": "/v1/images/generations", "destination": "/api/index" },
    { "source": "/v1/models", "destination": "/api/index" },
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/config", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/ping", "destination": "/api/index" },
    { "source": "/admin/console", "destination": "/admin.html" },
    { "source": "/admin/console/:path*", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/developers", "destination": "/developers/index.html" },
    { "source": "/developers/", "destination": "/developers/index.html" },
    { "source": "/developers/:path*", "destination": "/developers/:path*" },
    { "source": "/docs", "destination": "/developers/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "Access-Control-Max-Age", "value": "86400" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ],
  "functions": {
    "api/index.js": { "memory": 1024, "maxDuration": 60 }
  }
}
